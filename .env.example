# Copia este archivo a `.env` (no se versiona) y completa los valores.
# NUNCA subas `.env` al repositorio.

# Base de datos principal PostgreSQL/Neon (obligatoria).
# Formato: postgresql+psycopg2://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
MM_DATABASE_URL=

# Secreto JWT (obligatorio en cualquier entorno).
# Cadena aleatoria de al menos 32 caracteres, con variedad de caracteres.
# Generar por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca reutilizar entre entornos ni subir a Git.
MM_JWT_SECRET=

# SOLO desarrollo local: permite la clave fija si MM_JWT_SECRET está vacío.
# Nunca activar en producción (RENDER o MM_ENTORNO=produccion lo bloquean).
MM_JWT_PERMITIR_CLAVE_DESARROLLO=0

# Duración del token de acceso en horas (entero entre 1 y 24).
MM_TOKEN_HORAS=8

# Timeout (segundos) para abrir la conexión con PostgreSQL/Neon (default 5).
MM_DB_CONNECT_TIMEOUT=5

# Opcionales: si se definen, se emiten y validan estrictamente.
MM_JWT_ISSUER=
MM_JWT_AUDIENCE=

# Opcional: revocación global de tokens emitidos antes de una fecha
# (ISO-8601, ej. 2026-10-23T00:00:00Z, o timestamp Unix).
MM_JWT_REVOCAR_ANTES=

# Orígenes permitidos por CORS (frontend local/navegador).
MM_CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# MySQL del contenedor (módulo Proveedores/Compras/Detalles).
MYSQL_ROOT_PASSWORD=
MM_MYSQL_USER=iub
MM_MYSQL_PASSWORD=
MM_MYSQL_DATABASE=biblioteca_iub_compras

# URL de la API que se incrusta en el build de Angular (frontend en Docker).
API_URL=http://localhost:8000
{
  "name": "biblioteca-iub-api-express",
  "version": "1.0.0",
  "description": "API independiente Express + MySQL para la gestión de proveedores y compras de Biblioteca IUB (requisito 2 del parcial).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",

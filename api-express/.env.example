# ============================================================
# API Express + MySQL — Biblioteca IUB (proveedores y compras)
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` a Git (ya está excluido en .gitignore).
# ============================================================

# Puerto de la API
PORT=3001

# Conexión MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contrasena
DB_DATABASE=biblioteca_iub_compras
DB_POOL_LIMIT=10

# CORS: orígenes permitidos separados por coma ('*' permite todos)
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
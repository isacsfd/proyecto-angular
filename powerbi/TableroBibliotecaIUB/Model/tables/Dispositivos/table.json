  "partitions": [
    {
      "name": "Dispositivos-901f5fd1-90a6-52d1-9e28-420ed182d25d",
      "mode": "import",
      "source": {
        "type": "m",
        "expression": [
          "let",
          "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\dispositivos.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
          "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
          "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"ID\", Int64.Type}, {\"Alta\", type datetime}})",
          "in",
          "    Tipos"
        ]
      }
    }
  ],
  "measures": [
    {
      "name": "Dispositivos Totales",
      "expression": "COUNTROWS ( Dispositivos )",
      "formatString": "#,0",
      "lineageTag": "09b52028-15ba-589d-87d4-00515255923e"
    },
    {
      "name": "Dispositivos Disponibles",
      "expression": "CALCULATE ( COUNTROWS ( Dispositivos ), Dispositivos[Estado] = \"Disponible\" )",
      "formatString": "#,0",
      "lineageTag": "8360bbc5-d15b-5b4d-a040-b2196185d784",
      "description": "Equipos con estado Disponible."
    },
    {
      "name": "% Disponibilidad",
      "expression": "DIVIDE ( [Dispositivos Disponibles], [Dispositivos Totales] )",
      "formatString": "0.0%",
      "lineageTag": "2b946e01-e71b-5ec1-a623-e8ab75c7b87c"
    }
  ]

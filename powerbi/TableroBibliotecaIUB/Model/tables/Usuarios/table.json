        "type": "m",
        "expression": [
          "let",
          "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\usuarios_agregados.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",

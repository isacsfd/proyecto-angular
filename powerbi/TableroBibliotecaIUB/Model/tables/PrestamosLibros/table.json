    {
      "name": "PrestamosLibros-9c792403-5076-5e28-8813-91ccba5318ff",
      "mode": "import",
      "source": {
        "type": "m",
        "expression": [
          "let",
          "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\prestamos_libros.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
          "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
          "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"ID\", Int64.Type}, {\"FechaPrestamo\", type datetime}, {\"FechaEntrega\", type datetime}, {\"FechaDevolucion\", type datetime}})",
          "in",
          "    Tipos"
        ]
      }
    }
  ],
  "measures": [
    {
      "name": "Préstamos de Libros",
      "expression": "COUNTROWS ( PrestamosLibros )",
      "formatString": "#,0",
      "lineageTag": "75266954-9d95-5c88-86e6-1ee397ba6f31"
    },
    {
      "name": "Préstamos Activos",
      "expression": "CALCULATE ( COUNTROWS ( PrestamosLibros ), PrestamosLibros[Estado] = \"Activo\" )",
      "formatString": "#,0",
      "lineageTag": "9d8f9ecb-1594-55b3-b5ef-5de244d28a73"
    },
    {
      "name": "Préstamos Vencidos",
      "expression": "CALCULATE ( COUNTROWS ( PrestamosLibros ), PrestamosLibros[Estado] = \"Vencido\" )",
      "formatString": "#,0",
      "lineageTag": "14756280-76fb-5d8a-a91a-61ddcb31849f"
    },
    {
      "name": "Tasa de Aprobación",
      "expression": "DIVIDE ( CALCULATE ( COUNTROWS ( PrestamosLibros ), PrestamosLibros[Solicitud] = \"Aprobado\" ), [Préstamos de Libros] )",
      "formatString": "0.0%",
      "lineageTag": "c98ca1b2-51b7-5253-89c1-a304f7910b1a",
      "description": "Solicitudes de préstamo aprobadas sobre el total registrado."
    }
  ]

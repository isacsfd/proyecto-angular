  "partitions": [
    {
      "name": "Libros-f26de01a-2abb-5b00-b563-cb6418d6c956",
      "mode": "import",
      "source": {
        "type": "m",
        "expression": [
          "let",
          "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\libros.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
          "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
          "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
          "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"ID\", Int64.Type}, {\"Ejemplar\", Int64.Type}, {\"Anio\", Int64.Type}})",
          "in",
          "    Tipos"
        ]
      }
    }
  ],
  "measures": [
    {
      "name": "Total Libros",
      "expression": "COUNTROWS ( Libros )",
      "formatString": "#,0",
      "lineageTag": "4821f636-ef60-56c2-a849-adcfae8fd7c0",
      "description": "Filas del catálogo (una por registro de libro)."
    },
    {
      "name": "Total Ejemplares",
      "expression": "SUM ( Libros[Ejemplar] )",
      "formatString": "#,0",
      "lineageTag": "6f87cb95-4f0a-5838-ac32-b0385e05f448",
      "description": "Suma de la columna Ejemplar."
    },
    {
      "name": "Programas con Acervo",
      "expression": "CALCULATE ( DISTINCTCOUNT ( Libros[Programa] ), Libros[Programa] <> BLANK () )",
      "formatString": "#,0",
      "lineageTag": "a904ada4-ddcd-5e16-8953-fd5b0209a666",
      "description": "Programas distintos con al menos un libro registrado."
    }
  ]

        "partitions": [
          {
            "name": "Ingresos-39e97b83-f4a6-54e9-95e6-67de699109c1",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaDatos & \"\\ingresos.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    SinVacios = Table.ReplaceValue(Encabezados, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Encabezados)),",
                "    Tipos = Table.TransformColumnTypes(SinVacios, {{\"Fecha\", type datetime}}),",
                "    ConMes = Table.AddColumn(Tipos, \"Mes\", each Date.ToText([Fecha], \"yyyy-MM\"), type text),",
                "    ConPeriodo = Table.AddColumn(ConMes, \"Periodo\", each Date.StartOfMonth([Fecha]), type date)",
                "in",
                "    ConPeriodo"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ingresos Registrados",
            "expression": "COUNTROWS ( Ingresos )",
            "formatString": "#,0",
            "lineageTag": "fd76c60e-1e97-5fba-b99e-5e192bd55496",
            "description": "Accesos a biblioteca registrados (tabla library_access)."
          },
          {
            "name": "Ingresos Permitidos",
            "expression": "CALCULATE ( COUNTROWS ( Ingresos ), Ingresos[Estado] = \"Permitido\" )",
            "formatString": "#,0",
            "lineageTag": "356c4efa-534d-5f1d-bd63-3c86a0ad55c3"
          },
          {
            "name": "% Ingresos Permitidos",
            "expression": "DIVIDE ( [Ingresos Permitidos], [Ingresos Registrados] )",
            "formatString": "0.0%",
            "lineageTag": "c30d439b-f574-5f2c-b20f-2a5219c789ab"
          }
        ]
      },

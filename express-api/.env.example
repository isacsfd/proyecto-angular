# API Express local. No guardar secretos en el repositorio.
EXPRESS_PORT=4000

# Debe coincidir con el secreto configurado para FastAPI.
MM_JWT_SECRET=
MM_JWT_ISSUER=
MM_JWT_AUDIENCE=

# Express revalida el rol consultando FastAPI antes de autorizar compras.
FASTAPI_INTROSPECTION_URL=http://127.0.0.1:8000/api/auth/introspect
FASTAPI_INTROSPECTION_TIMEOUT_MS=2500

# MySQL local del módulo Proveedores/Compras/Detalles.
MM_MYSQL_HOST=127.0.0.1
MM_MYSQL_PORT=3306
MM_MYSQL_USER=root
MM_MYSQL_PASSWORD=
MM_MYSQL_DATABASE=biblioteca_iub_compras
MM_MYSQL_POOL=5
MM_MYSQL_CONNECT_TIMEOUT=5000

# Orígenes separados por coma. No usar * con credenciales.
EXPRESS_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
EXPRESS_RATE_LIMIT_MAX=120
EXPRESS_RATE_LIMIT_WINDOW_MS=60000

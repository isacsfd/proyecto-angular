# Biblioteca IUB — Ejemplo de variables de entorno para el bot de Telegram
# NO versionar valores reales. Copiar manualmente a .env (ignorado por git).

# Token de BotFather: SOLO por entorno o .env local (nunca en código).
TELEGRAM_BOT_TOKEN=

# Lista de autorizados separada por comas (ids de Telegram o @usuarios).
# Vacía => nadie está autorizado (fallo cerrado).
TELEGRAM_AUTHORIZED_USERS=

# Canal Open WebUI (solo localhost; el token solo por entorno).
OWUI_URL=http://127.0.0.1:3000
OWUI_TOKEN=

# LímitesTelegram: 4096 máx. por mensaje; configurable menor.
TELEGRAM_MAX_MSG_LEN=4000
TELEGRAM_MAX_CONCURRENCIA=3
TELEGRAM_TIMEOUT_S=900
LOG_BOT_LEVEL=INFO
